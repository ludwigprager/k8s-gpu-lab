# Settings for all numbered scripts.
# Every value can be overridden from the environment: MODEL_ID=... ./10-start.sh

# --- tools (15-install-tools.sh, all into ./.bin) ---------------------------------
# nvkind has no releases: a pinned module version, built with cgo in a golang container
NVKIND_VERSION=v0.0.0-20261123183009-b2a7778f0140
GO_IMAGE=golang:1.24
# nvkind runs the kind CLI; same version as in nvkind's go.mod
KIND_VERSION=0.31.0
KUBECTL_VERSION=1.34.1
HELM_VERSION=3.19.0

# --- cluster (20-create-cluster.sh) ------------------------------------------------
CLUSTER_NAME=gpu-lab
# RuntimeClass whose containerd handler runs GPU containers (set up by nvkind)
GPU_RUNTIME_CLASS=nvidia

NAMESPACE=app1

# --- model1 (vLLM) -----------------------------------------------------------
# Small, ungated chat model: fits any GPU with >= 4 GB VRAM.
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# Pin the version. If your host driver is older than CUDA 13 needs, use the -cu129 tag.
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
GPU_MEM_UTIL=0.80
MAX_MODEL_LEN=4096
# = number of GPUs model1 may use. 1 on a single-GPU machine.
MODEL_MAX_REPLICAS=1
# Optional, only for gated models
HF_TOKEN=
# Host directory for model1's Hugging Face cache (relative to the repo or absolute).
# Created by 11-create-dirs.sh, mounted as /models into the GPU node and the vLLM pod.
# Survives deleting the cluster; gone with the clone.
MODEL_CACHE_DIR=data/hf-cache
# Models already on disk, hard-linked by 11-create-dirs.sh into MODEL_CACHE_DIR/local/<name>
# (no extra space; must be on the same filesystem). Space-separated, empty = none.
# Use one with MODEL_ID=/models/local/<name>.
LOCAL_MODELS_SRC=~/ai/models
LOCAL_MODELS=Llama-2-13B-German-Assistant-v4-GPTQ

# --- app1 ----------------------------------------------------------------------
# Test client: plain Python image + app1/app.py from a ConfigMap (no build needed).
APP1_IMAGE=python:3.12-slim
APP1_HOST=app1.local

# --- GPU smoke test --------------------------------------------------------------
CUDA_SAMPLE_IMAGE=nvcr.io/nvidia/k8s/cuda-sample:vectoradd-cuda12.5.0

# --- GPU Operator --------------------------------------------------------------
# false: nvkind already installed the NVIDIA container toolkit inside the kind nodes
GPU_OPERATOR_TOOLKIT=false

# --- Helm charts (30-install-platform.sh), pinned: unpinned charts change their values ----
# Value names are checked against these versions (helm show values <chart> --version <v>).
GPU_OPERATOR_CHART_VERSION=v26.7.3
KUBE_PROMETHEUS_CHART_VERSION=93.10.0
KEDA_CHART_VERSION=2.21.1
KEDA_HTTP_CHART_VERSION=0.16.0
TRAEFIK_CHART_VERSION=43.0.0

# Local port for 80-test.sh (port-forward to traefik, 127.0.0.1 only).
# Not 8081: searxng (g1-assistant) publishes that one on this host.
LOCAL_PORT=18081
